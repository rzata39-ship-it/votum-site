# Formspree endpoint for the Get-in-touch contact modal.
# Sign up at https://formspree.io, create a form, and paste the
# endpoint URL here (e.g. https://formspree.io/f/xxxxxxxx).
# Copy this file to .env.local and fill in the real ID.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Newsletter sign-up on /blog (optional).
# Must accept:  POST multipart/form-data { email }  and answer 2xx on success
# (e.g. a second Formspree form, Buttondown, or your own function).
# While this is empty the newsletter section is NOT rendered in production
# builds; in `npm run dev` it is shown disabled with a warning.
VITE_NEWSLETTER_ENDPOINT=

# Indexing policy (src/config/environment.js). Only `production` is indexable;
# unset = development = noindex. Not needed on Vercel (derived from VERCEL_ENV).
# SITE_ENV=production
