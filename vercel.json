{
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about/index.html", "destination": "/about", "permanent": true },
    { "source": "/services/index.html", "destination": "/services", "permanent": true },
    { "source": "/services/technology-consulting/index.html", "destination": "/services/technology-consulting", "permanent": true },
    { "source": "/services/software-development/index.html", "destination": "/services/software-development", "permanent": true },
    { "source": "/services/devops-cloud/index.html", "destination": "/services/devops-cloud", "permanent": true },
    { "source": "/services/managed-services/index.html", "destination": "/services/managed-services", "permanent": true },
    { "source": "/services/test-automation/index.html", "destination": "/services/test-automation", "permanent": true },
    { "source": "/contact/index.html", "destination": "/contact", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/404.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
